      "charging cable",
      "light switch",
      "hanging clothes",
      "clothes hanger",
      "clothes rack",
      "towel",
      "helmet",
      "slippers",
      "sandals",
      "plastic basin",
      "bucket",
      "trash bin",
      "broom",
      "mop",
      "dustpan",
      "fan",
      "standing fan",
      "ceiling fan",
      "rice cooker",
      "electric kettle",
      "gas stove",
      "cooking pot",
      "frying pan",
      "cutting board",
      "plate",
      "chopsticks",
      "cabinet",
      "wardrobe",
      "shelf",
      "shoe rack",
      "door",
      "window",
      "curtain",
      "mirror",
      "plastic bag",
      "shopping bag",
      "cardboard box",
      "storage box",
      "wallet",
      "keys",
      "glasses",
      "medicine",
      "power bank"
    ],
    "open_vocab_exclude_labels": ["person"],
    "open_vocab_conf_threshold": 0.2,
    "open_vocab_iou_threshold": 0.5,
    "open_vocab_device": "cpu",
    "open_vocab_tile_imgsz": 960,
    "open_vocab_tiled_enabled": true,
    "open_vocab_tile_size": 960,
    "open_vocab_tile_overlap": 0.25,
    "open_vocab_tile_mode": "center_batch",
    "open_vocab_center_tile_count": 4,
    "open_vocab_redetect_enabled": false,
    "min_depth_m": 0.3,
    "max_depth_m": 8.0,
    "description_max_objects": 5,
    "debug_image_max_objects": 10,
    "yolo_device": "cpu"
  }
}
