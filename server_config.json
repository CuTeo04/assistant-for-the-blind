{
  "server": {
    "log_enabled": true,
    "host": "0.0.0.0",
    "port": 8000,
    "ssl_certfile": "${SSL_CERTFILE}",
    "ssl_keyfile": "${SSL_KEYFILE}"
  },
  "log": {
    "request_summary": true,
    "vision_detector_debug": false,
    "vision_detector_breakdown": false,
    "yolo_inference_trace": false,
    "vision_object_debug": false,
    "vision_debug_image": false,
    "hand_debug": true,
    "stt_debug": false,
    "response_debug": true,
    "http_client": true,
    "uvicorn_access": true
  },
  "stt": {
    "groq_api_key": "${GROQ_API_KEY}",
    "groq_base_url": "https://api.groq.com/openai/v1",
    "whisper_model": "whisper-large-v3",
    "whisper_lang": "vi",
    "llm_model": "llama-3.1-8b-instant",
    "llm_temperature": 0.1,
    "llm_max_tokens": 150
  },
  "response": {
    "api_key": "${DEEPSEEK_API_KEY}",
    "base_url": "https://api.deepseek.com",
    "llm_model": "deepseek-v4-flash",
    "max_tokens": 180,
    "temperature": 0,
    "thinking_enabled": false,
    "reasoning_effort": null,
    "log_cache_usage": true
  },
  "vision": {
    "real_hand_length_cm": 7.0,
    "known_distance_cm": 43.0,
    "fixed_focal_length_px": 730.0,
    "default_depth_scale": 1.0,
    "max_size": 1280,
    "device": "cpu",
    "num_threads": 12,
    "cpu_general_threads": 3,
    "yolo_onnx_intra_op_threads": 1,
    "yolo_onnx_inter_op_threads": 1,
    "da2_onnx_intra_op_threads": 2,
    "da2_onnx_inter_op_threads": 1,
    "yolo_world_onnx_intra_op_threads": 6,
    "yolo_world_onnx_inter_op_threads": 1,
    "input_size_depth": 518,
    "yolo_model_path": "models/YOLO11s.onnx",
    "yolo_onnx_path": "models/YOLO11s.onnx",
    "yolo_backend": "onnx",
    "yolo_execution_provider": "dml",
    "yolo_combined_batch_enabled": true,
    "yolo_combined_max_batch": 3,
    "da2_checkpoint": "models/checkpoints/depth_anything_v2_metric_hypersim_vits.pth",
    "da2_onnx_path": "models/checkpoints/depth_anything_v2_metric_hypersim_vits.onnx",
    "da2_use_onnx": true,
    "da2_config": {
      "encoder": "vits",
      "features": 64,
      "out_channels": [48, 96, 192, 384],
      "max_depth": 20.0
    },
    "conf_threshold": 0.5,
    "yolo_imgsz": 960,
    "allowed_classes": [
      "person",
      "backpack",
      "umbrella",
      "handbag",
      "tie",
      "suitcase",
      "bottle",
      "wine glass",
      "cup",
      "fork",
      "knife",
      "spoon",
      "bowl",
      "banana",
      "apple",
      "sandwich",
      "orange",
      "broccoli",
      "carrot",
      "hot dog",
      "pizza",
      "donut",
      "cake",
      "chair",
      "bench",
      "couch",
      "potted plant",
      "bed",
      "dining table",
      "toilet",
      "tv",
      "laptop",
      "mouse",
      "remote",
      "keyboard",
      "cell phone",
      "microwave",
      "oven",
      "toaster",
      "sink",
      "refrigerator",
      "book",
      "clock",
      "vase",
      "scissors",
      "teddy bear",
      "hair drier",
      "toothbrush"
    ],
    "yolo_predict_conf": 0.25,
    "yolo_tile_imgsz": 960,
    "tiled_enabled": true,
    "tile_size": 960,
    "tile_overlap": 0.25,
    "tile_mode": "center_batch",
    "center_tile_count": 4,
    "tile_conf_threshold": 0.2,
    "nms_iou_threshold": 0.5,
    "redetect_enabled": false,
    "redetect_classes": ["person", "chair", "bench", "bottle", "cup"],
    "redetect_containment_thr": 0.75,
    "redetect_iou_thr": 0.45,
    "redetect_center_dist_ratio": 0.35,
    "redetect_padding_ratio": 0.15,
    "redetect_imgsz": 960,
    "redetect_conf_thr": {
      "person": 0.25,
      "chair": 0.2,
      "bench": 0.25,
      "bottle": 0.25,
      "cup": 0.25
    },
    "redetect_max_candidates": 5,
    "redetect_fallback": "keep_both",
    "redetect_min_box_size": 16,
    "redetect_min_crop_size": 32,
    "open_vocab_enabled": true,
    "yolo_world_weights_path": "models/yolov8x-worldv2.pt",
    "yolo_world_model_path": "models/yolov8x-worldv2-legacy.onnx",
    "yolo_world_backend": "onnx",
    "yolo_world_execution_provider": "dml",
    "open_vocab_combined_batch_enabled": true,
    "open_vocab_combined_max_batch": 3,
    "open_vocab_extra_classes": [
      "stairs",
      "staircase",
      "handrail",
      "step ladder",
      "mattress",
      "blanket",
      "pillow",
      "bed sheet",
      "mosquito net",
      "floor mat",
      "electrical outlet",
      "power outlet",
      "power strip",
      "extension cord",
